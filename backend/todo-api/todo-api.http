@todo_api_HostAddress = http://localhost:5280

### Get all todos (default)
GET {{todo_api_HostAddress}}/api/todos?page=1&pageSize=20&status=All&sort=CreatedDesc
Accept: application/json

###

### Get active todos (newest first)
GET {{todo_api_HostAddress}}/api/todos?page=1&pageSize=20&status=Active&sort=CreatedDesc
Accept: application/json

###

### Get completed todos (oldest first)
GET {{todo_api_HostAddress}}/api/todos?page=1&pageSize=20&status=Completed&sort=CreatedAsc
Accept: application/json

###

### Get todos sorted by title (A–Z)
GET {{todo_api_HostAddress}}/api/todos?page=1&pageSize=20&status=All&sort=TitleAsc
Accept: application/json

###

### Create a todo
POST {{todo_api_HostAddress}}/api/todos
Content-Type: application/json

{
  "title": "First todo"
}

###

### Get todo by id
GET {{todo_api_HostAddress}}/api/todos/1
Accept: application/json

###

### Update a todo
PUT {{todo_api_HostAddress}}/api/todos/1
Content-Type: application/json

{
  "title": "Updated todo",
  "isCompleted": true
}

###

### Delete a todo
DELETE {{todo_api_HostAddress}}/api/todos/1
